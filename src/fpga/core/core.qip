# Intellivision core: file list. The macros and the device settings are in
# ap_core.qsf.

# Pocket glue: Analogue's template (core_top.v, core_bridge_cmd.v) and the
# PLL (generated).
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) core_top.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) core_bridge_cmd.v]
set_global_assignment -name QIP_FILE [file join $::quartus(qip_path) pll/pll_core.qip]

# agg23's analogue-pocket-utils (MIT), unmodified
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) ../pocket_utils/data_loader.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) ../pocket_utils/sync_fifo.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) ../pocket_utils/sound_i2s.sv]

# This project (MIT). intv_ss_pkg.sv (the save-state ids and blob layout,
# generated by tools/savestate.py) comes first: the modules import it.
